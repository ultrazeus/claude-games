{
  "name": "california-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "California Games (Epyx, 1987) remastered for the browser",
  "scripts": {
    "dev": "vite --port 5273 --strictPort",
    "build": "tsc --noEmit && vite build",
